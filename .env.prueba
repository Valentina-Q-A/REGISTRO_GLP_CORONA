
UBIDOTS_DEVICE=planta-prueba
UBIDOTS_TOKEN=

GLP_UBIDOTS_HISTORY_CONFIG=scripts/config-ubidots-glp-pruebas.js

GLP_CACHE_FILE=tmp-e2e-cache.xlsx
GLP_SYNC_CHECKPOINT=tmp-e2e-checkpoint.json

GLP_SYNC_PENDING_FILE=tmp-e2e-pending.json
GLP_SYNC_BACKUP_DIR=backups-e2e-temporal

GLP_SYNC_INTERVAL_MS=60000
GLP_AUTO_SYNC_ENABLED=true
GLP_SYNC_ON_STARTUP=true

UBIDOTS_QUEUE_RETRY_ENABLED=true